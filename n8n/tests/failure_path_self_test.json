{
  "id": "energylineFailureBranchCheck",
  "name": "EnergyLine \u2014 commissioning failure self-test (expected error)",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "start",
      "name": "Run commissioning",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\"passed\": false, \"failed_cases\": 1, \"report_url\": \"/test-only-failure\"}",
        "options": {}
      },
      "id": "suite",
      "name": "Run all S3 cases",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "suite-passed",
              "leftValue": "={{ $json.passed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check",
      "name": "All cases passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify({ status: 'PASS', total_cases: $json.total_cases, passed_cases: $json.passed_cases, failed_cases: $json.failed_cases, report: 'http://localhost:8787' + $json.report_url, cell: 'http://localhost:8787/cell', input_source: $json.input_source }) }}",
        "options": {}
      },
      "id": "summary",
      "name": "Commissioning summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        960,
        220
      ]
    },
    {
      "parameters": {
        "errorMessage": "={{ 'S3 commissioning failed: ' + $json.failed_cases + ' cases. Report: http://localhost:8787' + $json.report_url }}"
      },
      "id": "failed",
      "name": "Flag commissioning failure",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        960,
        420
      ]
    }
  ],
  "connections": {
    "Run commissioning": {
      "main": [
        [
          {
            "node": "Run all S3 cases",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run all S3 cases": {
      "main": [
        [
          {
            "node": "All cases passed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "All cases passed?": {
      "main": [
        [
          {
            "node": "Commissioning summary",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Flag commissioning failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
